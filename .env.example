# ─── LLM (Google Gemini — genuine free tier) ────────────────────────────────
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Client-side pacing to stay under the free tier (defaults match gemini-flash-lite-latest free tier)
GEMINI_RPM=10
GEMINI_TPM=250000
GEMINI_MAX_RETRIES=3

# ─── Database ──────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/interview-prep-kit

# ─── Auth ──────────────────────────────────────────────────────────────────
# 32+ random chars; used to sign session cookies / JWTs (required in production)
AUTH_SECRET=
# Session lifetime in hours (default 168 = 7 days)
SESSION_TTL_HOURS=168

# ─── API server ────────────────────────────────────────────────────────────
API_PORT=4000
# Comma-separated origins allowed to call the API (the web app)
WEB_ORIGIN=http://localhost:3000

# ─── Retrieval ─────────────────────────────────────────────────────────────
# Reject private/loopback targets when fetching external URLs.
# Set to "false" only for local batch fixtures served from localhost.
BLOCK_PRIVATE_ADDRESSES=true
CRAWL_MAX_PAGES=12
CRAWL_REQUESTS_PER_SECOND=2
HTTP_MAX_BODY_BYTES=2000000

# ─── Web app ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:4000
